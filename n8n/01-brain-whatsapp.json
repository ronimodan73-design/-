    },
    {
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": "={{ $json.מזהה_מדיה }}"
      },
      "id": "wa-media-img",
      "name": "הורדת התמונה",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [320, 140],
      "credentials": {
        "whatsAppApi": {
          "id": "WA_CRED",
          "name": "WhatsApp — רוני"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-flash-latest",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=את/ה בודק/ת מבחנים במתמטיקה עבור רוני, מורה למתמטיקה בחטיבת ביניים.\n\nלפניך תמונה של מבחן או דף עבודה של תלמיד.\n\nמשימתך:\n1. זהה את שם התלמיד אם מופיע.\n2. עבור על כל שאלה: מה התלמיד ענה, האם נכון, ואם לא — מה בדיוק הטעות.\n3. תן ניקוד לכל שאלה והצע ציון סופי.\n4. סיים בשורה אחת: מה הפער המרכזי של התלמיד ומה כדאי לתרגל איתו.\n\nכתוב בעברית, קצר וברור, בלי מבוא ובלי סיכומים מיותרים. זו תשובה שנקראת בוואטסאפ בטלפון — שורות קצרות, בלי טבלאות.\n\nהערה של רוני על הבדיקה (אם יש): {{ $('פירוק ההודעה').item.json.טקסט }}"
            }
          ]
        },
        "options": {}
      },
      "id": "gemini-vision",
      "name": "בדיקת המבחן",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [540, 140],
      "credentials": {
        "googlePalmApi": {
          "id": "GEMINI_CRED",
          "name": "Gemini — רוני"
        }
      }
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": "={{ $json.מזהה_מדיה }}"
      },
      "id": "wa-media-audio",
      "name": "הורדת ההקלטה",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [320, 460],
      "credentials": {
        "whatsAppApi": {
          "id": "WA_CRED",
          "name": "WhatsApp — רוני"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-flash-latest",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=תמלל את ההקלטה בעברית, ואז סכם אותה כסיכום פגישה מקצועי:\n\n*נושא הפגישה:*\n*משתתפים:* (אם נאמרו)\n*עיקרי הדברים:* (3-6 נקודות)\n*החלטות:*\n*מה רוני צריכה לעשות:* (משימות עם תאריך אם נאמר)\n\nכתוב בעברית בלבד. אם ההקלטה קצרה או לא ברורה — אמור זאת במשפט אחד ואל תמציא."
            }
          ]
        },
        "options": {}
      },
      "id": "gemini-audio",
      "name": "סיכום הפגישה",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [540, 460],
      "credentials": {
        "googlePalmApi": {
          "id": "GEMINI_CRED",
          "name": "Gemini — רוני"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.טקסט }}",
        "options": {
          "systemMessage": "=את העוזרת האישית של רוני מודן, מורה למתמטיקה בחטיבת ביניים בישראל.\n\nרוני מדברת אליך בוואטסאפ, במשפטים חופשיים, לפעמים עם שגיאות כתיב ובלי פיסוק. תביני את הכוונה — אל תבקשי ממנה לנסח מחדש.\n\n== מה את יודעת לעשות ==\nיש לך כלים. השתמשי בהם בלי לשאול רשות:\n- יומן גוגל: לקרוא מה יש לרוני היום/מחר/השבוע, ולקבוע אירועים ותזכורות\n- מייל: לשלוח מיילים בשמה\n- Google Docs: ליצור מסמכים (מערכי שיעור, דפי עבודה, מכתבים להורים, סיכומים)\n- Google Sheets: לרשום ולקרוא נתונים (ציונים, מעקב תלמידים, משימות)\n\n== איך את עונה ==\n- עברית בלבד.\n- קצר. זו הודעת וואטסאפ בטלפון, לא מסמך. 2-5 שורות ברוב המקרים.\n- בלי טבלאות, בלי כותרות מסגרת, בלי אימוג'ים מיותרים.\n- כשעשית משהו — תגידי מה עשית במשפט אחד. לא לפרט תהליך.\n- כשיצרת מסמך — תני את הקישור.\n\n== כללי עבודה ==\n1. אל תשאלי שאלות הבהרה על דברים קטנים. תחליטי לבד ותגידי מה החלטת. רוני תתקן אם צריך.\n2. שאלי רק כשבלי התשובה הפעולה תהיה שגויה (למשל: לא ברור לאיזו כיתה, ויש הבדל מהותי).\n3. תאריכים: היום הוא {{ $now.setZone('Asia/Jerusalem').format('cccc, d LLLL yyyy') }}. \"מחר\" = {{ $now.setZone('Asia/Jerusalem').plus({days:1}).toFormat('yyyy-MM-dd') }}. שעון ישראל תמיד.\n4. כשרוני מבקשת חומר לימודי (מערך שיעור, דף עבודה, מבחן) — תכיני אותו כמסמך ב-Google Docs, בעברית, מותאם לכיתות ז'-ט', עם שאלות מדורגות מקל לקשה ודרישה לנמק. אל תשלחי את כל התוכן בוואטסאפ — רק קישור ומשפט מה יש בפנים.\n5. אם רוני מבקשת משהו שאין לך כלי אליו — תגידי בכנות במשפט אחד מה חסר. אל תמציאי שעשית.\n\n== מה שאסור ==\nלעולם אל תמציאי מידע על תלמידים, ציונים, תאריכים או פגישות. אם את לא יודעת — תגידי."
        }
      },
